function TCL3MultivectorHelper.Inverse: TCL3Multivector;
begin
  case GradeMask of
    1: Exit(1.0 / fm0);
    2: Exit(TCL3Vector(Self).Inverse);
    4: Exit(TCL3Bivector(Self).Inverse);
    8: Exit(TCL3Trivector(Self).Inverse);
  end;
  result := ShirokovInverse(Self);
end;

function TCL3MultivectorHelper.GradeMask: longword;
begin
  // Bit g is set when some component of grade g is non-zero
  result := 0;
  if (fm0 <> 0.0) then result := result or 1;
  if (fm1 <> 0.0) or (fm2 <> 0.0) or (fm3 <> 0.0) then result := result or 2;
  if (fm12 <> 0.0) or (fm13 <> 0.0) or (fm23 <> 0.0) then result := result or 4;
  if (fm123 <> 0.0) then result := result or 8;
end;

