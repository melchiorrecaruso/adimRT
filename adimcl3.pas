function TCL3MultivectorHelper.SquaredNorm: double;
begin
  result := fm0 * fm0
          + fm1 * fm1
          + fm2 * fm2
          + fm3 * fm3
          + fm12 * fm12
          + fm13 * fm13
          + fm23 * fm23
          + fm123 * fm123;
end;

