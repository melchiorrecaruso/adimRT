  LRow, LColumn: longint;
begin
  for LRow := 0 to Self.Order - 1 do
    for LColumn := LRow to Self.Order - 1 do
      if not Self.FValue[LRow, LColumn].SameValue(
        Self.FValue[LColumn, LRow].Conjugate) then Exit(False);
  result := True;
end;

