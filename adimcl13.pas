function TCL13VectorHelper.Dot(const AVector: TCL13Trivector): TCL13Bivector;
begin
  result.fm01 := -fm2 * AVector.fm012
               - fm3 * AVector.fm013;
  result.fm02 := fm1 * AVector.fm012
               - fm3 * AVector.fm023;
  result.fm03 := fm1 * AVector.fm013
               + fm2 * AVector.fm023;
  result.fm12 := fm0 * AVector.fm012
               - fm3 * AVector.fm123;
  result.fm13 := fm0 * AVector.fm013
               + fm2 * AVector.fm123;
  result.fm23 := fm0 * AVector.fm023
               - fm1 * AVector.fm123;
end;

