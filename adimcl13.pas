end;

function TCL13MultivectorHelper.Norm: double;
begin
  result := Sqrt(Abs(SquaredNorm));
end;

function TCL13MultivectorHelper.SquaredNorm: double;
begin
  result := fms * fms
          + fm0 * fm0
          - fm1 * fm1
          - fm2 * fm2
          - fm3 * fm3
          - fm01 * fm01
          - fm02 * fm02
          - fm03 * fm03
          + fm12 * fm12
          + fm13 * fm13
          + fm23 * fm23
          + fm012 * fm012
          + fm013 * fm013
          + fm023 * fm023
          - fm123 * fm123
          - fm0123 * fm0123;
end;

