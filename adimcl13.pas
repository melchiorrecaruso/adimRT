                 - fm1 * AVector.fm023
                 + fm2 * AVector.fm013
                 - fm3 * AVector.fm012
                 + fm01 * AVector.fm23
                 - fm02 * AVector.fm13
                 + fm03 * AVector.fm12
                 + fm12 * AVector.fm03
                 - fm13 * AVector.fm02
                 + fm23 * AVector.fm01
