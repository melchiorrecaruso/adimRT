  result.fm03 := -fm12;
  result.fm12 := fm03;
  result.fm13 := -fm02;
  result.fm23 := fm01;
  result.fm012 := fm3;
  result.fm013 := -fm2;
  result.fm023 := fm1;
  result.fm123 := fm0;
  result.fm0123 := fms;
end;

function TCL13MultivectorHelper.Involute: TCL13Multivector;
begin
