              + fm2 * AVector.fm02
              + fm3 * AVector.fm03;
  result.fm1 := fm0 * AVector.fm01
              + fm2 * AVector.fm12
              + fm3 * AVector.fm13;
  result.fm2 := fm0 * AVector.fm02
              - fm1 * AVector.fm12
              + fm3 * AVector.fm23;
  result.fm3 := fm0 * AVector.fm03
