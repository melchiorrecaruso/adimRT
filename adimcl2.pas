function TCL2MultivectorHelper.Dot(const AVector: TCL2Vector): TCL2Multivector;
begin
  result.fm0 := fm1 * AVector.fm1
              + fm2 * AVector.fm2;
  result.fm1 := fm0 * AVector.fm1
              + fm12 * AVector.fm2;
  result.fm2 := fm0 * AVector.fm2
              - fm12 * AVector.fm1;
  result.fm12 := 0.0;
end;

function TCL2MultivectorHelper.Dot(const AVector: TCL2Bivector): TCL2Multivector;
begin
  result.fm0 := -fm12 * AVector.fm12;
  result.fm1 := -fm2 * AVector.fm12;
  result.fm2 := fm1 * AVector.fm12;
  result.fm12 := fm0 * AVector.fm12;
end;

function TCL2MultivectorHelper.Dot(const AVector: TCL2Multivector): TCL2Multivector;
begin
  result.fm0 := fm0 * AVector.fm0
              + fm1 * AVector.fm1
              + fm2 * AVector.fm2
              - fm12 * AVector.fm12;
  result.fm1 := fm0 * AVector.fm1
              + fm1 * AVector.fm0
              - fm2 * AVector.fm12
              + fm12 * AVector.fm2;
  result.fm2 := fm0 * AVector.fm2
              + fm1 * AVector.fm12
              + fm2 * AVector.fm0
              - fm12 * AVector.fm1;
  result.fm12 := fm0 * AVector.fm12
               + fm12 * AVector.fm0;
end;

function TCL2MultivectorHelper.Wedge(const AVector: TCL2Vector): TCL2Multivector;
begin
  result.fm0 := 0.0;
  result.fm1 := fm0 * AVector.fm1;
  result.fm2 := fm0 * AVector.fm2;
  result.fm12 := fm1 * AVector.fm2
               - fm2 * AVector.fm1;
end;

function TCL2MultivectorHelper.Wedge(const AVector: TCL2Bivector): TCL2Bivector;
begin
  result.fm12 := fm0 * AVector.fm12;
end;

function TCL2MultivectorHelper.Wedge(const AVector: TCL2Multivector): TCL2Multivector;
begin
  result.fm0 := fm0 * AVector.fm0;
  result.fm1 := fm0 * AVector.fm1
              + fm1 * AVector.fm0;
  result.fm2 := fm0 * AVector.fm2
              + fm2 * AVector.fm0;
  result.fm12 := fm0 * AVector.fm12
               + fm1 * AVector.fm2
               - fm2 * AVector.fm1
               + fm12 * AVector.fm0;
end;

