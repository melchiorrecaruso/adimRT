  result := Math.SameValue(fm0, 0.0) and
            Math.SameValue(fm1, 0.0) and
            Math.SameValue(fm2, 0.0) and
            Math.SameValue(fm12, AValue.fm12);
end;

function TCL2MultivectorHelper.SameValue(const AValue: TCL2Vector): boolean;
