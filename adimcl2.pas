implementation

uses
  Math;

function Fmt(const AValue: double; APrecision, ADigits: longint): string;
begin
  if APrecision < 0 then
    result := FloatToStr(AValue)
  else
    result := FloatToStrF(AValue, ffGeneral, APrecision, ADigits);
  if AValue >= 0.0 then
    result := '+' + result;
end;

function ComponentsToString(const AValues: array of double; const ANames: array of string;
  APrecision, ADigits: longint): string;
var
  i: longint;
begin
  result := '';
  for i := Low(AValues) to High(AValues) do
    if not Math.SameValue(AValues[i], 0.0) then
    begin
      if result <> '' then result := result + ' ';
      result := result + Fmt(AValues[i], APrecision, ADigits) + ANames[i];
    end;
  if result = '' then result := '0';
end;

function GeometricScalar(const ALeft, ARight: TCL2Multivector): double;
begin
  result := ALeft.fm0 * ARight.fm0
          + ALeft.fm1 * ARight.fm1
          + ALeft.fm2 * ARight.fm2
          - ALeft.fm12 * ARight.fm12;
end;

function ShirokovInverse(const AValue: TCL2Multivector): TCL2Multivector;
const
  N = 2; // 2^ceil(n/2), n = 2
var
  U: TCL2Multivector;
  k: longint;
begin
  // U(1) = A; U(k) = A (U(k-1) - C(k-1)); C(k) = N/k <U(k)>_0
  // A^-1 = (U(N-1) - C(N-1)) / C(N)
  U := AValue;
  U.fm0 := U.fm0 - N * U.fm0;
  for k := 2 to N - 1 do
  begin
    U := AValue * U;
    U.fm0 := U.fm0 - (N / k) * U.fm0;
  end;
  result := U / GeometricScalar(AValue, U);
end;

// TCL2Multivector

class operator TCL2Multivector.:=(const AValue: double): TCL2Multivector;
begin
  result.fm0 := AValue;
  result.fm1 := 0.0;
  result.fm2 := 0.0;
  result.fm12 := 0.0;
end;

class operator TCL2Multivector.Explicit(const AValue: TCL2Multivector): double;
begin
  result := AValue.fm0;
end;

class operator TCL2Multivector.=(const ALeft: TCL2Multivector; const ARight: double): boolean;
begin
  result := (ALeft.fm0 = ARight) and
            (ALeft.fm1 = 0.0) and
            (ALeft.fm2 = 0.0) and
            (ALeft.fm12 = 0.0);
end;

class operator TCL2Multivector.=(const ALeft: double; const ARight: TCL2Multivector): boolean;
begin
  result := (ALeft = ARight.fm0) and
            (0.0 = ARight.fm1) and
            (0.0 = ARight.fm2) and
            (0.0 = ARight.fm12);
end;

class operator TCL2Multivector.=(const ALeft, ARight: TCL2Multivector): boolean;
begin
  result := (ALeft.fm0 = ARight.fm0) and
            (ALeft.fm1 = ARight.fm1) and
            (ALeft.fm2 = ARight.fm2) and
            (ALeft.fm12 = ARight.fm12);
end;

class operator TCL2Multivector.<>(const ALeft: TCL2Multivector; const ARight: double): boolean;
begin
  result := not (ALeft = ARight);
end;

class operator TCL2Multivector.<>(const ALeft: double; const ARight: TCL2Multivector): boolean;
begin
  result := not (ALeft = ARight);
end;

class operator TCL2Multivector.<>(const ALeft, ARight: TCL2Multivector): boolean;
begin
  result := not (ALeft = ARight);
end;

class operator TCL2Multivector.-(const AValue: TCL2Multivector): TCL2Multivector;
begin
  result.fm0 := -AValue.fm0;
  result.fm1 := -AValue.fm1;
  result.fm2 := -AValue.fm2;
