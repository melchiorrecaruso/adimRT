function TCL2MultivectorHelper.SameValue(const AValue: TCL2Multivector): boolean;
begin
  result := Math.SameValue(fm0, AValue.fm0) and
            Math.SameValue(fm1, AValue.fm1) and
            Math.SameValue(fm2, AValue.fm2) and
            Math.SameValue(fm12, AValue.fm12);
end;

function TCL2MultivectorHelper.SameValue(const AValue: TCL2Bivector): boolean;
