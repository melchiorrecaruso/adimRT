            Math.SameValue(fm1, 0.0) and
            Math.SameValue(fm2, 0.0) and
            Math.SameValue(fm12, 0.0);
end;

function TCL2MultivectorHelper.IsNull: boolean;
begin
  result := SameValue(NullMultivector);
end;

function TCL2MultivectorHelper.IsScalar: boolean;
begin
  result := (not Math.SameValue(fm0, 0.0)) and
            Math.SameValue(fm1, 0.0) and
            Math.SameValue(fm2, 0.0) and
            Math.SameValue(fm12, 0.0);
end;

function TCL2MultivectorHelper.IsVector: boolean;
begin
  result := (not Math.SameValue(fm1, 0.0) or not Math.SameValue(fm2, 0.0)) and
            Math.SameValue(fm0, 0.0) and
            Math.SameValue(fm12, 0.0);
end;

function TCL2MultivectorHelper.IsBivector: boolean;
begin
  result := (not Math.SameValue(fm12, 0.0)) and
            Math.SameValue(fm0, 0.0) and
            Math.SameValue(fm1, 0.0) and
            Math.SameValue(fm2, 0.0);
end;

function TCL2MultivectorHelper.IsA: string;
begin
  if IsNull then Exit('Null');
  if IsBivector then Exit('TCL2Bivector');
  if IsVector then Exit('TCL2Vector');
  if IsScalar then Exit('TScalar');
  result := 'TCL2Multivector';
end;

