function TCL2MultivectorHelper.SquaredNorm: double;
begin
  result := fm0 * fm0
          + fm1 * fm1
          + fm2 * fm2
          + fm12 * fm12;
end;

function TCL2MultivectorHelper.Dual: TCL2Multivector;
begin
  result.fm0 := -fm12;
  result.fm1 := -fm2;
  result.fm2 := fm1;
  result.fm12 := fm0;
end;

function TCL2MultivectorHelper.Involute: TCL2Multivector;
begin
  result.fm0 := fm0;
  result.fm1 := -fm1;
  result.fm2 := -fm2;
  result.fm12 := fm12;
end;

function TCL2MultivectorHelper.Reverse: TCL2Multivector;
begin
  result.fm0 := fm0;
  result.fm1 := fm1;
  result.fm2 := fm2;
  result.fm12 := -fm12;
end;

function TCL2MultivectorHelper.Conjugate: TCL2Multivector;
begin
  result.fm0 := fm0;
  result.fm1 := -fm1;
  result.fm2 := -fm2;
  result.fm12 := -fm12;
end;

function TCL2MultivectorHelper.Inverse: TCL2Multivector;
begin
  case GradeMask of
    1: Exit(1.0 / fm0);
    2: Exit(TCL2Vector(Self).Inverse);
    4: Exit(TCL2Bivector(Self).Inverse);
  end;
  result := ShirokovInverse(Self);
end;

function TCL2MultivectorHelper.GradeMask: longword;
begin
  // Bit g is set when some component of grade g is non-zero
  result := 0;
  if (fm0 <> 0.0) then result := result or 1;
  if (fm1 <> 0.0) or (fm2 <> 0.0) then result := result or 2;
  if (fm12 <> 0.0) then result := result or 4;
end;

function TCL2MultivectorHelper.Normalized: TCL2Multivector;
begin
  result := Self / Norm;
end;

