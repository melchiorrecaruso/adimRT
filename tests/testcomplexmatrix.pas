{ TestComplexMatrix.pas - Complex matrix (TComplexMatrix) tests for ADimMath.

  Part of the modular ADimMath test suite.  Registers itself with
  TestFramework; the main program runs it automatically.

  To add a new test case here: add statements inside an existing Test*
  procedure, or write a new Test* procedure and call it from Run below.

  @author  Melchiorre Caruso
}
unit TestComplexMatrix;

{$mode objfpc}{$H+}{$J-}
{$modeswitch advancedrecords}
{$modeswitch typehelpers}

interface

implementation

uses
  Math, SysUtils, StrUtils, ADimMath, TestFramework;


type
  T5DSpace = record
    const N = 5;
  end;

  T6DSpace = record
    const N = 6;
  end;

  T5ComplexMatrix = specialize TComplexMatrix<T5DSpace>;
  T6ComplexMatrix = specialize TComplexMatrix<T6DSpace>;

procedure TestTCMatrix;
var
  ZA, ZB, ZRes: T2ComplexMatrix;
  i, j: integer;

  procedure LoadZA;
  begin
    // ZA = [[1+2i, 3-i],[i, 2]]
    ZA.Assign([C(1,2),C(3,-1), C(0,1),C(2,0)]);
  end;

  procedure LoadZB;
  begin
    // ZB = [[1-i, 2i],[3, 1+i]]
    ZB.Assign([C(1,-1),C(0,2), C(3,0),C(1,1)]);
  end;

begin
  Section('TCMatrix - Init / basic properties');

  LoadZA;
  Check('ZA order=2 (T2ComplexMatrix)', Math.SameValue(ZA[1,1].Re, 2, EPS));
  CheckCplxNear('ZA[0,0]=1+2i',ZA[0,0], C(1,2), EPS);
  CheckCplxNear('ZA[1,0]=0+1i',ZA[1,0], C(0,1), EPS);

  try
    ZA.Assign([C(1,0), C(2,0), C(3,0)]);
    Check('Assign rejects wrong dimension', False);
  except
    on EArgumentException do
      Check('Assign rejects wrong dimension', True);
  end;
  LoadZA;

  Section('TCMatrix - Add / Sub / Mul / Determinant / Trace');

  LoadZA; LoadZB;

  // ZA+ZB = [[2+i,3+i],[3+i,3+i]]
  ZRes := ZA + ZB;
  CheckCplxNear('ZA+ZB [0,0]=2+1i', ZRes[0,0], C(2,1), EPS);
  CheckCplxNear('ZA+ZB [0,1]=3+1i', ZRes[0,1], C(3,1), EPS);
  CheckCplxNear('ZA+ZB [1,0]=3+1i', ZRes[1,0], C(3,1), EPS);
  CheckCplxNear('ZA+ZB [1,1]=3+1i', ZRes[1,1], C(3,1), EPS);

  // ZA-ZB = [[2i, 3-3i],[-3+i, 1-i]]  (from numpy)
  ZRes := ZA - ZB;
  CheckCplxNear('ZA-ZB [0,0]=0+3i',  ZRes[0,0], C(0,3),  EPS);
  CheckCplxNear('ZA-ZB [0,1]=3-3i',  ZRes[0,1], C(3,-3), EPS);
  CheckCplxNear('ZA-ZB [1,0]=-3+1i', ZRes[1,0], C(-3,1), EPS);
  CheckCplxNear('ZA-ZB [1,1]=1-1i',  ZRes[1,1], C(1,-1), EPS);

  // ZA*ZB from numpy: [[12-2i, 4i],[7+i, 2i]]
  ZRes := ZA * ZB;
  CheckCplxNear('ZA*ZB [0,0]=12-2i', ZRes[0,0], C(12,-2), EPS);
  CheckCplxNear('ZA*ZB [0,1]=0+4i',  ZRes[0,1], C(0,4),   EPS);
  CheckCplxNear('ZA*ZB [1,0]=7+1i',  ZRes[1,0], C(7,1),   EPS);
  CheckCplxNear('ZA*ZB [1,1]=0+2i',  ZRes[1,1], C(0,2),   EPS);

  // det(ZA) = (1+2i)*2 - (3-i)*i = 2+4i - (3i - i^2) = 2+4i - (-1+3i) = 3+i
  CheckCplxNear('det(ZA)=1+1i', ZA.Determinant, C(1,1), EPS);

  // trace(ZA) = (1+2i)+2 = 3+2i
  CheckCplxNear('trace(ZA)=3+2i', ZA.Trace, C(3,2), EPS);

  Section('TCMatrix - Conjugate / TransposeConjugate / IsUnitary');

  LoadZA;
  // conj(ZA): [[1-2i,3+i],[-i,2]]
  ZRes := ZA.Conjugate;
  CheckCplxNear('conj(ZA)[0,0]=1-2i', ZRes[0,0], C(1,-2), EPS);
  CheckCplxNear('conj(ZA)[0,1]=3+1i', ZRes[0,1], C(3,1),  EPS);
  CheckCplxNear('conj(ZA)[1,0]=0-1i', ZRes[1,0], C(0,-1), EPS);
  CheckCplxNear('conj(ZA)[1,1]=2+0i', ZRes[1,1], C(2,0),  EPS);

  // ZA^H = conj(ZA)^T: [[1-2i,-i],[3+i,2]]
  ZRes := ZA.TransposeConjugate;
  CheckCplxNear('ZA^H [0,0]=1-2i', ZRes[0,0], C(1,-2), EPS);
  CheckCplxNear('ZA^H [0,1]=0-1i', ZRes[0,1], C(0,-1), EPS);
  CheckCplxNear('ZA^H [1,0]=3+1i', ZRes[1,0], C(3,1),  EPS);
  CheckCplxNear('ZA^H [1,1]=2+0i', ZRes[1,1], C(2,0),  EPS);

  // Identity is unitary
  ZRes := ZA.Identity;
  Check('I2 (complex) IsUnitary=true', ZRes.IsUnitary);

  // ZA (non-unitary) is not
  LoadZA;
  Check('ZA IsUnitary=false', not ZA.IsUnitary);

  // Build a 2x2 unitary: Hadamard / sqrt(2)
  // H = [[1,1],[1,-1]] / sqrt(2)  -> H^H * H = I
  ZA[0,0] := C(1/sqrt(2), 0); ZA[0,1] := C(1/sqrt(2), 0);
  ZA[1,0] := C(1/sqrt(2), 0); ZA[1,1] := C(-1/sqrt(2),0);
  Check('Hadamard IsUnitary=true', ZA.IsUnitary);
end;

procedure TestComplexMatrices;
var
  ZA, ZB, ZP, ZH, ZInv, U, Prod, Id: T3ComplexMatrix;
  i, j: integer;
begin
  ZA.Assign([
    C(1,2), C(3,-1), C(0,1),
    C(2,0), C(1,-1), C(4,2),
    C(0,-1),C(2,3),  C(1,0)]);
  ZB.Assign([
    C(1,-1),C(0,2),  C(1,0),
    C(3,0), C(1,1),  C(0,-2),
    C(2,1), C(0,0),  C(3,-1)]);

  // -- Multiplication --
  BeginCategory('Complex matrix multiply');
  ZP := ZA * ZB;
  CmpC('ZA*ZB[0,0]', ZP[0,0], 11.0, 0.0);
  CmpC('ZA*ZB[0,1]', ZP[0,1], 0.0, 4.0);
  CmpC('ZA*ZB[0,2]', ZP[0,2], 0.0, -1.0);
  CmpC('ZA*ZB[1,0]', ZP[1,0], 11.0, 3.0);
  CmpC('ZA*ZB[1,1]', ZP[1,1], 2.0, 4.0);
  CmpC('ZA*ZB[1,2]', ZP[1,2], 14.0, 0.0);
  CmpC('ZA*ZB[2,0]', ZP[2,0], 7.0, 9.0);
  CmpC('ZA*ZB[2,1]', ZP[2,1], 1.0, 5.0);
  CmpC('ZA*ZB[2,2]', ZP[2,2], 9.0, -6.0);

  // -- Determinant / Trace / Norm --
  BeginCategory('Complex det / trace / norm');
  CmpC('det(ZA)',   ZA.Determinant, 22.000000000000004, -26.000000000000004);
  CmpC('trace(ZA)', ZA.Trace, 3.0, 1.0);
  CmpR('norm(ZA)',  ZA.Norm, 7.54983443527075);

  // -- Conjugate transpose --
  BeginCategory('Complex conjugate transpose');
  ZH := ZA.TransposeConjugate;
  CmpC('ZA^H[0,0]', ZH[0,0], 1.0, -2.0);
  CmpC('ZA^H[0,1]', ZH[0,1], 2.0, 0.0);
  CmpC('ZA^H[0,2]', ZH[0,2], 0.0, 1.0);
  CmpC('ZA^H[1,0]', ZH[1,0], 3.0, 1.0);
  CmpC('ZA^H[1,1]', ZH[1,1], 1.0, 1.0);
  CmpC('ZA^H[1,2]', ZH[1,2], 2.0, -3.0);
  CmpC('ZA^H[2,0]', ZH[2,0], 0.0, -1.0);
  CmpC('ZA^H[2,1]', ZH[2,1], 4.0, -2.0);
  CmpC('ZA^H[2,2]', ZH[2,2], 1.0, 0.0);

  // -- Inverse --
  BeginCategory('Complex inverse');
  ZInv := ZA.Inverse;
  CmpC('inv(ZA)[0,0]', ZInv[0,0],  0.36206896551724144, -0.3448275862068967);
  CmpC('inv(ZA)[1,1]', ZInv[1,1], -0.04482758620689656,  0.03793103448275863);
  CmpC('inv(ZA)[2,2]', ZInv[2,2], -0.1241379310344828,  -0.010344827586206895);
  // Reconstruction ZA*inv ~= I
  Prod := ZA * ZInv;
  Id   := ZA.Identity;
  for i := 0 to 2 do
    for j := 0 to 2 do
      CmpC(Format('ZA*inv-I[%d,%d]',[i,j]), Prod[i,j], Id[i,j].Re, Id[i,j].Im);

  // -- Unitary matrix verification --
  BeginCategory('Complex unitary (U^H U = I)');
  U.Assign([
    C(-0.7048886121359774, -0.250386352910629),
    C(-0.04961052821187585, 0.3617015399352434),
    C(-0.46758283807826867, 0.29751604963566775),
    C(-0.16991968030918747, -0.21069172375789536),
    C(-0.6153785201339133, 0.11585381958077612),
    C(0.6855937150337083, 0.25413525362721434),
    C(0.0003712589818964662, 0.605949569442415),
    C(-0.6877420387085238, -0.04011046170758114),
    C(-0.3722714532827376, -0.14014630064588512)]);
  // U^H * U should equal identity
  Prod := U.TransposeConjugate * U;
  Id   := U.Identity;
  for i := 0 to 2 do
    for j := 0 to 2 do
      CmpC(Format('U^H*U-I[%d,%d]',[i,j]), Prod[i,j], Id[i,j].Re, Id[i,j].Im);
  Track(IfThen(U.IsUnitary, 0.0, 1.0));
end;

