{ SpecLinear - SolveLinear, Inverse, Determinant, Rank and RowReduction.

  The matrix classes follow the LAPACK linear-equation tests (xCHKGE):
  diagonal, upper and lower triangular, random with cond = 2, ill
  conditioned with cond = sqrt(1/eps) and cond = 0.1/eps (generated by
  xLATMS with every singular-value mode), scaled near underflow and near
  overflow, and singular matrices with a zero column. Ratios:

    DGET02  ||b - A*x||_1 / (||A||_1 ||x||_1 eps)            < 30
    DGET03  ||I - inv(A)*A||_1 / (n ||A||_1 ||inv(A)||_1 eps) < 30
    DGET04  ||x - x_true||_2 / (||x_true||_2 cond_2(A) eps)   < 30

  (threshold 30 from dtest.in and ztest.in). The determinant of a
  generated matrix has modulus prod(sigma_i); its relative error is
  checked against n * cond_2(A) * eps, the first-order condition of the
  determinant for a backward-stable factorization. }
unit SpecLinear;

{$mode objfpc}{$H+}{$J-}
{$modeswitch advancedrecords}
{$modeswitch typehelpers}
{$modeswitch nestedprocvars}

interface

implementation

uses
  SysUtils, Math, ADimMath, TestRunner, TestDoubleDouble, TestGenerators,
  TestMeasures;

type
  TMatrixClass = (mcDiagonal, mcUpper, mcLower, mcWellConditioned,
    mcIllConditioned, mcNearlySingular, mcNearUnderflow, mcNearOverflow);

const
  ClassNames: array[TMatrixClass] of string = ('diagonal', 'upper triangular',
    'lower triangular', 'cond 2', 'cond sqrt(1/eps)', 'cond 0.1/eps',
    'scaled 1e-290', 'scaled 1e290');
  ModeNames: array[TSigmaMode] of string = ('one large', 'one small',
    'geometric', 'arithmetic', 'random log');

{ A generated test matrix together with cond_2 and |det|. }
procedure MakeReal(AClass: TMatrixClass; N: Integer; AMode: TSigmaMode;
  out A: TRealMatrix; out ACond, ALogDet: Double);
var
  I, J: Integer;
  LSigma: TArrayOfReal;
  LScale: Double;
begin
  LScale := 1;
  case AClass of
    mcIllConditioned: ACond := Sqrt(1 / UnitRoundoff);
    mcNearlySingular: ACond := 0.1 / UnitRoundoff;
  else
    ACond := 2;
  end;
  if AClass = mcNearUnderflow then LScale := 1E-290;
  if AClass = mcNearOverflow then LScale := 1E290;
  case AClass of
    mcDiagonal, mcUpper, mcLower:
      begin
        A := NewRealMatrix(N);
        LSigma := SigmaValues(N, AMode, ACond);
        for I := 0 to N - 1 do
        begin
          A[I, I] := LSigma[I] * (1 - 2 * (I mod 2));
          for J := 0 to N - 1 do
            if ((AClass = mcUpper) and (J > I)) or ((AClass = mcLower) and (J < I)) then
              A[I, J] := RandomUniform / N;
        end;
        { Condition and determinant of triangular matrices are computed
          from the matrix itself where needed; ACond = 0 marks unknown. }
        if AClass <> mcDiagonal then ACond := 0;
        ALogDet := 0;
        for I := 0 to N - 1 do ALogDet := ALogDet + Ln(System.Abs(A[I, I]));
      end;
  else
    begin
      LSigma := SigmaValues(N, AMode, ACond);
      A := RealMatrixWithSigma(LSigma, LScale);
      ALogDet := 0;
      for I := 0 to N - 1 do ALogDet := ALogDet + Ln(LSigma[I] * LScale);
    end;
  end;
end;

procedure SolveChecks;
const
  Orders: array[0..6] of Integer = (1, 2, 3, 5, 10, 16, 32);
var
  LClass: TMatrixClass;
  LMode: TSigmaMode;
  S, I, K: Integer;
  A: TRealMatrix;
  CA: TComplexMatrix;
  X, B, XTrue: TRealVector;
  CX, CB, CXTrue: TComplexVector;
  LCond, LLogDet, LDet, LScale: Double;
  LSum: TDD;
  LCSum: TDDComplex;
  J: Integer;
  LLabel: string;
begin
  Group('SolveLinear residual (DGET02/ZGET02)', ckStability,
    LAPACKLinearThreshold, tsLAPACK, 'dtest.in/ztest.in');
  SetSeed(701);
  K := 0;
  for S := Low(Orders) to High(Orders) do
    for LClass := Low(TMatrixClass) to High(TMatrixClass) do
      for LMode := Low(TSigmaMode) to High(TSigmaMode) do
      begin
        LLabel := Format('n=%d %s mode %s', [Orders[S], ClassNames[LClass], ModeNames[LMode]]);
        MakeReal(LClass, Orders[S], LMode, A, LCond, LLogDet);
        XTrue := RandomRealVector(Orders[S]);
        B := NewRealVector(Orders[S]);
        for I := 0 to Orders[S] - 1 do
        begin
          LSum := 0;
          for J := 0 to Orders[S] - 1 do LSum := LSum + TwoProd(A[I, J], XTrue[J]);
          B[I] := LSum.ToDouble;
        end;
        X := A.SolveLinear(B);
        CheckRatio('real ' + LLabel, SolveRatio(A, X, B));
        CA := RealToComplexMatrix(A) * Complex(Cos(K + 0.5), Sin(K + 0.5));
        CXTrue := RandomComplexVector(Orders[S]);
        CB := NewComplexVector(Orders[S]);
        for I := 0 to Orders[S] - 1 do
        begin
          LCSum := DDComplex(0, 0);
          for J := 0 to Orders[S] - 1 do
            LCSum := LCSum + TDDComplex(CA[I, J]) * TDDComplex(CXTrue[J]);
          CB[I] := LCSum.ToComplex;
        end;
        CX := CA.SolveLinear(CB);
        CheckRatio('complex ' + LLabel, SolveRatio(CA, CX, CB));
        Inc(K);
      end;

  Group('SolveLinear forward error (DGET04/ZGET04, 2-norm)', ckAccuracy,
    LAPACKLinearThreshold, tsLAPACK, 'dtest.in/ztest.in');
  SetSeed(702);
  for S := Low(Orders) to High(Orders) do
    for LClass := mcWellConditioned to mcNearOverflow do
      for LMode := Low(TSigmaMode) to High(TSigmaMode) do
      begin
        MakeReal(LClass, Orders[S], LMode, A, LCond, LLogDet);
        LScale := 1;
        XTrue := RandomRealVector(Orders[S]);
        B := NewRealVector(Orders[S]);
        for I := 0 to Orders[S] - 1 do
        begin
          LSum := 0;
          for J := 0 to Orders[S] - 1 do LSum := LSum + TwoProd(A[I, J], XTrue[J]);
          B[I] := LSum.ToDouble;
        end;
        { The rounded right-hand side changes the exact solution by at most
          cond * eps * ||x||, which the ratio already allows for. }
        X := A.SolveLinear(B);
        CheckRatio(Format('n=%d %s mode %s', [Orders[S], ClassNames[LClass],
          ModeNames[LMode]]), ForwardRatio(X, XTrue, LCond) / LScale);
      end;

  Group('Determinant modulus, relative error', ckAccuracy, ProjectThreshold,
    tsProject, 'n * cond_2 * eps');
  SetSeed(703);
  for S := Low(Orders) to High(Orders) do
    for LClass := mcDiagonal to mcIllConditioned do
      for LMode := Low(TSigmaMode) to High(TSigmaMode) do
      begin
        if LClass in [mcUpper, mcLower] then Continue;
        MakeReal(LClass, Orders[S], LMode, A, LCond, LLogDet);
        LDet := A.Determinant;
        CheckRatio(Format('n=%d %s mode %s', [Orders[S], ClassNames[LClass],
          ModeNames[LMode]]),
          System.Abs(Ln(System.Abs(LDet)) - LLogDet) /
          (Orders[S] * Max(LCond, 1) * UnitRoundoff));
      end;
end;

procedure InverseChecks;
const
  Orders: array[0..5] of Integer = (1, 2, 3, 5, 10, 24);
var
  LClass: TMatrixClass;
  LMode: TSigmaMode;
  S: Integer;
  A: TRealMatrix;
  CA: TComplexMatrix;
  LCond, LLogDet: Double;
begin
  Group('Inverse residual (DGET03/ZGET03)', ckStability, LAPACKLinearThreshold,
    tsLAPACK, 'dtest.in/ztest.in');
  SetSeed(711);
  for S := Low(Orders) to High(Orders) do
    for LClass := Low(TMatrixClass) to High(TMatrixClass) do
      for LMode := Low(TSigmaMode) to High(TSigmaMode) do
      begin
        MakeReal(LClass, Orders[S], LMode, A, LCond, LLogDet);
        CheckRatio(Format('real n=%d %s mode %s', [Orders[S], ClassNames[LClass],
          ModeNames[LMode]]), InverseRatio(A, A.Inverse));
        CA := RealToComplexMatrix(A) * Complex(0.6, -0.8);
        CheckRatio(Format('complex n=%d %s mode %s', [Orders[S], ClassNames[LClass],
          ModeNames[LMode]]), InverseRatio(CA, CA.Inverse));
      end;
  A := HilbertMatrix(6);
  CheckRatio('Hilbert 6', InverseRatio(A, A.Inverse));
  A := KahanMatrix(20, 1.2);
  CheckRatio('Kahan 20', InverseRatio(A, A.Inverse));
end;

procedure SingularChecks;
var
  A, AInverse: TRealMatrix;
  X, B: TRealVector;
  N, LColumn, I: Integer;

  procedure SolveSingular;
  begin
    X := A.SolveLinear(B);
  end;

  procedure InvertSingular;
  begin
    AInverse := A.Inverse;
  end;

  procedure SolveMismatched;
  begin
    X := A.SolveLinear(NewRealVector(N + 1));
  end;

begin
  Group('Singular matrices (zero column) and dimension errors', ckContract);
  SetSeed(721);
  for N := 2 to 6 do
    for LColumn in [0, N div 2, N - 1] do
    begin
      A := RandomRealMatrix(N);
      for I := 0 to N - 1 do A[I, LColumn] := 0;
      B := RandomRealVector(N);
      CheckRaises(Format('SolveLinear n=%d zero column %d', [N, LColumn]),
        EZeroDivide, @SolveSingular);
      CheckRaises(Format('Inverse n=%d zero column %d', [N, LColumn]),
        EZeroDivide, @InvertSingular);
      CheckEqual(Format('Determinant n=%d zero column %d', [N, LColumn]),
        A.Determinant, 0);
      CheckEqual(Format('Rank n=%d zero column %d', [N, LColumn]), A.Rank, N - 1);
    end;
  N := 3;
  A := RandomRealMatrix(N);
  CheckRaises('SolveLinear with wrong vector size', EDimensionError, @SolveMismatched);
end;

procedure RankAndReductionChecks;
const
  Scales: array[0..4] of Double = (1E-200, 1E-50, 1, 1E50, 1E200);
var
  N, R, K, T, I, J: Integer;
  A, U, V, Reduced: TRealMatrix;
  CA: TComplexMatrix;
  LSigma: TArrayOfReal;
  LSum: TDD;
begin
  Group('Rank of matrices with prescribed rank (all scales)', ckProperty);
  SetSeed(731);
  for N := 1 to 8 do
    for R := 0 to N do
      for T := Low(Scales) to High(Scales) do
      begin
        U := RandomOrthogonal(N);
        V := RandomOrthogonal(N);
        SetLength(LSigma, N);
        for I := 0 to N - 1 do
          if I < R then LSigma[I] := Power(10, -3 * RandomUniform) else LSigma[I] := 0;
        A := NewRealMatrix(N);
        for I := 0 to N - 1 do
          for J := 0 to N - 1 do
          begin
            LSum := 0;
            for K := 0 to N - 1 do LSum := LSum + TwoProd(U[I, K] * LSigma[K], V[J, K]);
            A[I, J] := LSum.ToDouble * Scales[T];
          end;
        CheckEqual(Format('n=%d rank %d scale %g', [N, R, Scales[T]]), A.Rank, R);
        CA := RealToComplexMatrix(A) * Complex(0, 1);
        CheckEqual(Format('complex n=%d rank %d scale %g', [N, R, Scales[T]]),
          CA.Rank, R);
      end;

  Group('RowReduction of nonsingular matrices gives the identity', ckStability,
    ProjectThreshold, tsProject, '||RREF - I||_1 / (n cond_2 eps)');
  SetSeed(732);
  for N := 1 to 10 do
    for T := Low(Scales) to High(Scales) do
    begin
      A := GenerateRealMatrix(N, smRandomLog, 10, Scales[T]);
      Reduced := A.RowReduction;
      CheckRatio(Format('n=%d scale %g', [N, Scales[T]]),
        MatrixOneNorm(Reduced - A.Identity) / (N * 10 * UnitRoundoff));
    end;

  Group('RowReduction is idempotent on rank-deficient matrices', ckProperty);
  A.Init([1, 2, 3, 2, 4, 6, 1, 0, 1]);
  Reduced := A.RowReduction;
  Check('RREF(RREF(A)) = RREF(A)', Reduced.RowReduction = Reduced);
  Check('pivot structure', (Reduced[0, 0] = 1) and (Reduced[1, 1] = 1) and
    (Reduced[2, 0] = 0) and (Reduced[2, 1] = 0) and (Reduced[2, 2] = 0));
end;

procedure Run;
begin
  Guard(@SolveChecks);
  Guard(@InverseChecks);
  Guard(@SingularChecks);
  Guard(@RankAndReductionChecks);
end;

initialization
  RegisterSpec('Linear systems (SolveLinear, Inverse, Determinant, Rank)', @Run);
end.
